# Docker Compose runtime configuration. Copy to an untracked .env and set real values.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=duban
MYSQL_USER=duban
MYSQL_PASSWORD=replace-with-a-strong-application-password
# 默认复用已有 Docker named volume；迁移完成后可改为 /srv/duban-data/mysql。
DUBAN_MYSQL_DATA_ROOT=mysql_data
DATABASE_URL=mysql://duban:replace-with-a-strong-application-password@mysql:3306/duban
PORT=3001
FRONTEND_URL=http://localhost
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
# 生产环境连接独立 Redis 服务器；本地可留空并回退进程内缓存。
REDIS_URL=redis://redis-user:replace-with-a-strong-password@redis-host:6379/0
REDIS_REQUIRED=true
REDIS_RETRY_DELAY_MS=10000
# 腾讯云 COS 私有 Bucket。真实凭证仅保存在服务器私有 .env。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=replace-with-your-bucket-appid
COS_REGION=ap-guangzhou
COS_PREFIX=duban
MAX_ATTACHMENT_BYTES=10485760
COS_SIGNED_URL_TTL_SECONDS=300
NODE_ENV=production
