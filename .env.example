# Docker Compose runtime configuration. Copy to an untracked .env and set real values.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=duban
MYSQL_USER=duban
MYSQL_PASSWORD=replace-with-a-strong-application-password
DATABASE_URL=mysql://duban:replace-with-a-strong-application-password@mysql:3306/duban
PORT=3001
FRONTEND_URL=http://localhost
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
NODE_ENV=production
