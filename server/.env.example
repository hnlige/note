# Local/server runtime configuration. Keep the real .env outside Git.
DATABASE_URL=mysql://duban:replace-with-a-strong-application-password@127.0.0.1:3306/duban
PORT=3001
FRONTEND_URL=http://localhost:5173
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# Redis 配置（可选，未配置时回退到本地内存缓存）
REDIS_URL=
REDIS_REQUIRED=false
REDIS_RETRY_DELAY_MS=10000

# 数据库连接池配置（500 并发优化）
DB_POOL_SIZE=50          # 单实例连接数（从 30 → 50）
DB_QUEUE_LIMIT=100       # 队列深度限制，防止 OOM（从 0 → 100）
DB_QUERY_TIMEOUT=        # 可选：查询超时（毫秒）

# 限流配置
RATE_LIMIT_PER_MINUTE=600  # 每用户每分钟请求限制（生产环境建议 1200）

# COS 对象存储配置
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PREFIX=duban
MAX_ATTACHMENT_BYTES=10485760
COS_SIGNED_URL_TTL_SECONDS=300

NODE_ENV=development
